/* ════════════════════════════════════════════════════════
   PREP — Landing Page
   Palette + type scale mirror the student app (Figma).
   Signature: OMR "bubble sheet" texture + live CSS 3D app screens.
   ════════════════════════════════════════════════════════ */

/* ───────── 1. Tokens ───────── */
:root{
  /* brand — lifted from the app's Figma variables */
  --navy-900:#0B2140;
  --navy-800:#0F2745;
  --navy-700:#152C4E;
  --navy-600:#16305C;
  --navy-500:#123E63;

  --teal-600:#17787F;
  --teal-500:#2E9C8E;
  --teal-400:#3FA9AF;

  --gold-600:#A8861C;
  --gold-500:#C9A227;
  --gold-400:#D6AF3A;

  --red-500:#C0453B;

  /* surfaces */
  --bg:#FFFFFF;
  --tint:#F4F7F8;
  --tint-2:#EDF2F3;
  --line:#E1E8EA;
  --line-2:#DCE6EF;

  /* ink */
  --ink:#152C4E;
  --ink-2:#3A4B57;
  --ink-3:#6B7C86;
  --ink-4:#9AA0AE;
  --ink-onDark:#C4D6E2;

  /* type */
  --ff-d:"Alexandria","Cairo",system-ui,"Segoe UI",sans-serif;
  --ff-b:"Cairo",system-ui,"Segoe UI",sans-serif;

  /* geometry */
  --wrap:1200px;
  --r-s:12px;
  --r-m:18px;
  --r-l:26px;
  --r-xl:34px;

  /* phone */
  --pw:240px;

  --ease:cubic-bezier(.22,.68,.28,1);
}

/* ───────── 2. Reset ───────── */
*,*::before,*::after{box-sizing:border-box}
html{-webkit-text-size-adjust:100%;scroll-behavior:smooth}
body{
  margin:0;
  font-family:var(--ff-b);
  font-size:16px;
  line-height:1.75;
  color:var(--ink-2);
  background:var(--bg);
  -webkit-font-smoothing:antialiased;
  overflow-x:hidden;
}
img,svg{display:block;max-width:100%}
h1,h2,h3,h4,h5{margin:0;font-family:var(--ff-d);color:var(--ink);line-height:1.25;font-weight:700}
p{margin:0}
ul,ol,dl{margin:0;padding:0;list-style:none}
dd{margin:0}
a{color:inherit;text-decoration:none}
button{font:inherit;color:inherit;background:none;border:0;cursor:pointer}
:focus-visible{outline:3px solid var(--gold-500);outline-offset:3px;border-radius:6px}

.sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap;border:0}
.skip-link{
  position:absolute;top:-100px;inset-inline-start:16px;z-index:200;
  background:var(--gold-500);color:var(--navy-900);font-weight:700;
  padding:10px 18px;border-radius:0 0 var(--r-s) var(--r-s);transition:top .2s;
}
.skip-link:focus{top:0}

.wrap{width:min(100% - 40px,var(--wrap));margin-inline:auto}
.wrap--narrow{width:min(100% - 40px,860px)}

/* ───────── 3. Bubble-sheet texture (the signature) ─────────
   Every standardised test in this world is answered on an OMR
   sheet. That grid is the page's ambient texture — rings, with a
   few "shaded" bubbles in brand colours falling on grid centres. */
.hero__sheet{
  position:absolute;inset:0;pointer-events:none;
  background-image:
    radial-gradient(circle at 133px 95px, rgba(201,162,39,.34) 0 5.4px, transparent 5.6px),
    radial-gradient(circle at 19px 19px,  rgba(63,169,175,.30) 0 5.4px, transparent 5.6px),
    radial-gradient(circle at 19px 19px,  transparent 0 4.5px, rgba(255,255,255,.075) 4.6px 5.6px, transparent 5.8px);
  background-size:266px 266px, 190px 190px, 38px 38px;
  mask-image:radial-gradient(120% 90% at 70% 20%, #000 30%, transparent 78%);
}
.hero__sheet--soft{opacity:.6}

/* ───────── 4. Buttons ───────── */
.btn{
  display:inline-flex;align-items:center;justify-content:center;gap:8px;
  font-family:var(--ff-d);font-weight:600;font-size:.95rem;line-height:1;
  padding:15px 30px;border-radius:999px;
  transition:transform .18s var(--ease),box-shadow .18s var(--ease),background-color .18s,color .18s,border-color .18s;
  white-space:nowrap;
}
.btn:hover{transform:translateY(-2px)}
.btn:active{transform:translateY(0)}

.btn--gold{background:var(--gold-500);color:var(--navy-900);box-shadow:0 10px 24px -10px rgba(201,162,39,.85)}
.btn--gold:hover{background:var(--gold-400);box-shadow:0 16px 30px -12px rgba(201,162,39,.95)}

.btn--ghost{color:#fff;border:1.5px solid rgba(255,255,255,.34);backdrop-filter:blur(4px)}
.btn--ghost:hover{border-color:rgba(255,255,255,.75);background:rgba(255,255,255,.08)}

.btn--outline{color:var(--navy-700);border:1.5px solid var(--line-2)}
.btn--outline:hover{border-color:var(--navy-700);background:var(--navy-700);color:#fff}

.btn--white{background:#fff;color:var(--navy-700);box-shadow:0 2px 10px -2px rgba(11,33,64,.14)}
.btn--white:hover{background:var(--navy-700);color:#fff;box-shadow:0 8px 20px -8px rgba(11,33,64,.5)}

.btn--sm{padding:11px 22px;font-size:.875rem}
.btn--lg{padding:18px 40px;font-size:1.05rem}
.btn--full{display:flex;width:100%}

/* ───────── 5. Nav ───────── */
.nav{position:fixed;inset-block-start:0;inset-inline:0;z-index:100;transition:background-color .3s,box-shadow .3s,backdrop-filter .3s}
.nav__in{
  width:min(100% - 40px,var(--wrap));margin-inline:auto;
  display:flex;align-items:center;justify-content:space-between;gap:20px;
  padding-block:14px;
}
/* the logo sits in a white chip — it reads as the app icon,
   which is exactly what this page is selling */
.brand{
  display:grid;place-items:center;
  background:#fff;border-radius:16px;padding:7px 12px;
  box-shadow:0 6px 18px -8px rgba(11,33,64,.5);
  transition:transform .2s var(--ease);
}
.brand:hover{transform:translateY(-1px)}
.brand__mark{width:88px;height:auto}

.nav__links{display:flex;align-items:center;gap:30px}
.nav__links a{font-size:.94rem;font-weight:500;color:rgba(255,255,255,.82);transition:color .2s;position:relative}
.nav__links a:not(.btn):hover{color:#fff}
.nav__links a:not(.btn)::after{
  content:"";position:absolute;inset-block-end:-6px;inset-inline-start:0;
  width:0;height:2px;background:var(--gold-500);transition:width .25s var(--ease);
}
.nav__links a:not(.btn):hover::after{width:100%}
.nav__cta{color:var(--navy-900)!important}

.nav.is-stuck{background:rgba(11,33,64,.9);backdrop-filter:blur(14px);box-shadow:0 1px 0 rgba(255,255,255,.09)}

.nav__burger{display:none;flex-direction:column;gap:5px;padding:10px;border-radius:10px}
.nav__burger span{display:block;width:22px;height:2px;background:#fff;border-radius:2px;transition:transform .25s,opacity .2s}
.nav__burger[aria-expanded="true"] span:nth-child(1){transform:translateY(7px) rotate(45deg)}
.nav__burger[aria-expanded="true"] span:nth-child(2){opacity:0}
.nav__burger[aria-expanded="true"] span:nth-child(3){transform:translateY(-7px) rotate(-45deg)}

/* ───────── 6. Hero ───────── */
.hero{
  position:relative;overflow:hidden;
  padding-block:clamp(130px,15vw,180px) clamp(70px,9vw,110px);
  background:
    radial-gradient(120% 80% at 78% 8%, #1B3A63 0%, transparent 55%),
    linear-gradient(200deg,var(--navy-700) 0%,var(--navy-900) 62%);
  color:#fff;
}
.hero__glow{
  position:absolute;inset-block-start:-12%;inset-inline-end:-6%;
  width:640px;height:640px;border-radius:50%;pointer-events:none;
  background:radial-gradient(circle,rgba(63,169,175,.22),transparent 62%);
  filter:blur(20px);
}
.hero__in{
  position:relative;display:grid;grid-template-columns:1.13fr .87fr;
  gap:clamp(30px,4vw,52px);align-items:center;
}

.chips{display:flex;flex-wrap:wrap;gap:8px;margin-block-end:26px}
.chips li{
  font-family:var(--ff-d);font-size:.76rem;font-weight:500;letter-spacing:.02em;
  padding:6px 14px;border-radius:999px;
  color:var(--teal-400);border:1px solid rgba(63,169,175,.35);background:rgba(63,169,175,.09);
}

.hero__h1{
  /* tuned so each of the two lines fits without breaking, from 375px up */
  font-size:clamp(1.63rem,3.9vw,2.85rem);
  line-height:1.26;letter-spacing:-.01em;color:#fff;
  text-wrap:balance;
}
.hero__h1 em{display:block;font-style:normal;color:var(--gold-500)}

.hero__lead{
  margin-block-start:22px;max-width:37em;
  font-size:clamp(.98rem,1.15vw,1.09rem);color:var(--ink-onDark);line-height:1.88;
}

.hero__acts{display:flex;flex-wrap:wrap;gap:14px;margin-block-start:34px}

.hero__trust{
  display:flex;flex-wrap:wrap;gap:clamp(22px,3vw,44px);
  margin-block-start:44px;padding-block-start:28px;
  border-block-start:1px solid rgba(255,255,255,.13);
}
.hero__trust dt{font-size:.8rem;color:rgba(196,214,226,.75);order:2}
.hero__trust dd{font-family:var(--ff-d);font-size:1.6rem;font-weight:700;color:#fff;line-height:1.2;font-variant-numeric:tabular-nums}
.hero__trust-of{font-size:.9rem;color:rgba(196,214,226,.6)}

/* ───────── 7. The 3D cluster ───────── */
.stage{perspective:1900px;perspective-origin:50% 44%}
.cluster{
  position:relative;height:545px;transform-style:preserve-3d;
  transform:rotateX(var(--rx,5deg)) rotateY(var(--ry,-14deg));
  transition:transform .5s var(--ease);
  will-change:transform;
}
/* physical left/top on purpose — the transforms below are physical too,
   so logical properties would mirror the cluster out of the column */
.phone{
  position:absolute;top:50%;left:50%;
  width:var(--pw);margin:0;
  transform-style:preserve-3d;
  animation:phoneIn .9s var(--ease) both;
}
.phone--l{transform:translate(-50%,-50%) translateX(-140px) translateZ(-46px) rotateY(19deg) scale(.9);z-index:1;animation-delay:.14s}
.phone--c{transform:translate(-50%,-50%) translateZ(62px);z-index:3;animation-delay:0s}
.phone--r{transform:translate(-50%,-50%) translateX(140px) translateZ(-46px) rotateY(-19deg) scale(.9);z-index:2;animation-delay:.28s}

@keyframes phoneIn{
  from{opacity:0;filter:blur(6px)}
  to{opacity:1;filter:blur(0)}
}

.phone__body{
  position:relative;aspect-ratio:250/516;
  border-radius:42px;padding:8px;
  background:linear-gradient(160deg,#2b2f36 0%,#0d0f12 40%,#000 100%);
  box-shadow:
    0 0 0 1px rgba(255,255,255,.09),
    0 42px 80px -26px rgba(4,15,33,.85),
    0 16px 34px -14px rgba(4,15,33,.6);
}
.phone__notch{
  position:absolute;top:8px;left:50%;transform:translateX(-50%);
  width:74px;height:21px;border-radius:0 0 13px 13px;background:#000;z-index:6;
}
.phone__screen{
  position:relative;height:100%;border-radius:35px;overflow:hidden;
  background:var(--tint);display:flex;flex-direction:column;
  font-family:var(--ff-b);color:var(--ink);
}

/* status bar */
.sb{
  display:flex;align-items:center;justify-content:space-between;
  padding:9px 18px 3px;font-size:9px;font-weight:700;color:var(--navy-700);flex:none;
}
.sb__ic{width:22px;height:7px;border-radius:2px;background:currentColor;opacity:.55}
.sb--dark{color:var(--navy-700)}

/* shared bits inside screens */
.bar{height:4px;border-radius:99px;background:var(--line);overflow:hidden;flex:1}
.bar > i{display:block;height:100%;width:var(--w,0);border-radius:99px;transition:width 1.1s var(--ease)}
.bar--teal{background:var(--teal-500)}
.bar--gold{background:var(--gold-500)}
.bar--navy{background:var(--navy-700)}
.bar--grad{background:linear-gradient(90deg,var(--teal-400),var(--gold-500))}
.bar--onDark{background:rgba(255,255,255,.2)}
.dot{width:5px;height:5px;border-radius:50%;display:inline-block;flex:none}
.dot--teal{background:var(--teal-500)}
.dot--gold{background:var(--gold-500)}
.c-teal{color:var(--teal-500)}
.c-gold{color:var(--gold-600)}
.c-navy{color:var(--navy-700)}

.scr{flex:1;min-height:0;padding:10px 12px 12px;display:flex;flex-direction:column;gap:9px;overflow:hidden}
.scr__cta{
  margin-block-start:auto;padding:9px;border-radius:99px;
  background:var(--teal-600);color:#fff;font-size:10px;font-weight:700;font-family:var(--ff-d);
}

/* — home screen — */
.hhead{display:flex;align-items:center;justify-content:space-between}
.hhead__id{display:flex;align-items:center;gap:7px}
.ava{
  width:26px;height:26px;border-radius:50%;background:var(--navy-700);color:#fff;
  display:grid;place-items:center;font-size:10px;font-weight:700;flex:none;
}
.hhead__id small{display:block;font-size:7.5px;color:var(--ink-4);line-height:1.3}
.hhead__id b{display:block;font-size:11px;color:var(--navy-700);line-height:1.3}
.hhead__ic{display:flex;gap:6px}
.iconbtn{
  position:relative;width:23px;height:23px;border-radius:50%;background:#fff;
  border:1px solid var(--line);display:grid;place-items:center;
}
.iconbtn svg{width:11px;height:11px;fill:none;stroke:var(--navy-700);stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}
.dot-live{position:absolute;inset-block-start:3px;inset-inline-end:4px;width:4px;height:4px;border-radius:50%;background:var(--gold-500)}

.today{
  position:relative;border-radius:17px;padding:11px 12px;color:#fff;
  background:radial-gradient(110% 130% at 12% 8%,#1E4571 0%,var(--navy-800) 58%,var(--navy-900) 100%);
  box-shadow:0 8px 18px -10px rgba(11,33,64,.7);
}
.today__row1{display:flex;align-items:center;justify-content:space-between;margin-block-end:8px}
.today__tag{background:var(--gold-500);color:var(--navy-900);font-size:7.5px;font-weight:700;padding:3px 8px;border-radius:99px}
.today__cd{font-size:7.5px;color:rgba(255,255,255,.62)}
.today__h{font-size:13px;color:#fff;margin-block-end:2px}
.today p{font-size:8px;color:rgba(196,214,226,.8)}
.today__row2{display:flex;align-items:center;gap:8px;margin-block-start:11px}
.play{width:26px;height:26px;border-radius:50%;background:#fff;display:grid;place-items:center;flex:none}
.play svg{width:11px;height:11px;fill:var(--navy-700)}
.today__pct{font-size:8px;font-weight:700;color:var(--teal-400);flex:none}

.grid3{display:grid;grid-template-columns:repeat(3,1fr);gap:6px}
.kpi,.quick{
  background:#fff;border:1px solid var(--line);border-radius:13px;
  padding:8px 4px;display:flex;flex-direction:column;align-items:center;gap:2px;
}
.kpi b{font-family:var(--ff-d);font-size:13px;color:var(--navy-700);line-height:1.1}
.kpi small,.quick small{font-size:7px;color:var(--ink-4)}
.quick__ic{width:20px;height:20px;border-radius:7px;display:grid;place-items:center;margin-block-end:2px}
.quick__ic svg{width:11px;height:11px;fill:none;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}
.quick__ic--navy{background:#E4EAF3}
.quick__ic--navy svg{stroke:var(--navy-700)}
.quick__ic--teal{background:#DCF3EE}
.quick__ic--teal svg{stroke:var(--teal-600)}
.quick__ic--gold{background:#FBF3DC}
.quick__ic--gold svg{stroke:var(--gold-600)}
.quick small{color:var(--navy-700);font-weight:600;font-size:7.5px}

.mock{
  display:flex;align-items:center;gap:8px;
  background:#fff;border:1px solid var(--line);border-radius:99px;padding:7px 10px;
}
.mock__ic{width:20px;height:20px;border-radius:50%;background:var(--tint-2);display:grid;place-items:center;flex:none}
.mock__ic svg{width:11px;height:11px;fill:none;stroke:var(--navy-700);stroke-width:1.8;stroke-linecap:round}
.mock__t{flex:1;min-width:0}
.mock__t b{display:block;font-size:9.5px;color:var(--navy-700);line-height:1.3}
.mock__t small{display:block;font-size:7px;color:var(--ink-4)}
.mock__go{color:var(--ink-4);font-size:12px;line-height:1}

.tabbar{
  display:grid;grid-template-columns:repeat(4,1fr);
  padding:7px 6px 10px;background:#fff;border-block-start:1px solid var(--line);flex:none;
}
.tabbar__i{display:flex;flex-direction:column;align-items:center;gap:2px;color:var(--ink-4)}
.tabbar__i svg{width:14px;height:14px;fill:none;stroke:currentColor;stroke-width:1.7;stroke-linejoin:round}
.tabbar__i small{font-size:6.5px}
.tabbar__i.is-on{color:var(--navy-700)}
.tabbar__i.is-on svg{fill:rgba(21,44,78,.09)}

/* — result screen — */
.scr--result{padding:0;gap:0}
.result__top{
  background:radial-gradient(100% 120% at 80% 0%,#1E4571 0%,var(--navy-800) 55%,var(--navy-900) 100%);
  padding:16px 14px 30px;text-align:center;color:#fff;
}
.ring{position:relative;width:78px;height:78px;margin:0 auto 12px}
.ring svg{width:100%;height:100%;transform:rotate(-90deg)}
.ring circle{fill:none;stroke-width:7;stroke-linecap:round}
.ring__bg{stroke:rgba(255,255,255,.14)}
.ring__fg{
  stroke:var(--gold-500);
  stroke-dasharray:264;stroke-dashoffset:264;
  transition:stroke-dashoffset 1.4s var(--ease);
}
.ring.is-in .ring__fg{stroke-dashoffset:53}
.ring__val{position:absolute;inset:0;display:grid;place-content:center;gap:0}
.ring__val b{font-family:var(--ff-d);font-size:21px;line-height:1;color:#fff}
.ring__val small{font-size:7px;color:rgba(196,214,226,.75)}
.result__title{font-family:var(--ff-d);font-size:14px;font-weight:700;color:#fff}
.result__sub{font-size:7.5px;color:rgba(196,214,226,.78);line-height:1.7;margin-block-start:4px}

.result__list{margin-block-start:-18px;padding:0 11px;display:flex;flex-direction:column;gap:7px}
.mrow{background:#fff;border-radius:13px;padding:9px 10px;box-shadow:0 4px 12px -8px rgba(11,33,64,.35)}
.mrow__h{display:flex;align-items:center;justify-content:space-between;margin-block-end:5px}
.mrow__h span{font-size:9.5px;font-weight:700;color:var(--navy-700)}
.mrow__h b{font-family:var(--ff-d);font-size:9.5px}
.mrow__n{font-size:6.8px;color:var(--ink-4);margin-block-start:5px}
.scr--result .scr__cta{margin:12px 11px 12px}

/* — lesson screen — */
.lhead{display:flex;align-items:center;gap:8px;padding-block-start:2px}
.lhead__back{
  width:21px;height:21px;border-radius:50%;background:#fff;border:1px solid var(--line);
  display:grid;place-items:center;color:var(--navy-700);font-size:12px;flex:none;
}
.lhead b{display:block;font-family:var(--ff-d);font-size:12px;color:var(--navy-700);line-height:1.3}
.lhead small{display:block;font-size:7px;color:var(--ink-4)}
.llist{display:flex;flex-direction:column;gap:6px;margin-block-start:4px}
.llist li{
  display:flex;align-items:center;gap:8px;
  background:#fff;border:1px solid var(--line);border-radius:99px;padding:6px 9px;
}
.llist li.is-on{border-color:var(--gold-500);box-shadow:0 0 0 2px rgba(201,162,39,.15)}
.llist__ic{width:22px;height:22px;border-radius:50%;display:grid;place-items:center;flex:none}
.llist__ic svg{width:11px;height:11px;fill:none;stroke-width:1.7;stroke-linecap:round;stroke-linejoin:round}
.llist__ic--navy{background:#E4EAF3}   .llist__ic--navy svg{stroke:var(--navy-700)}
.llist__ic--teal{background:#DCF3EE}   .llist__ic--teal svg{stroke:var(--teal-600)}
.llist__ic--gold{background:#FBF3DC}   .llist__ic--gold svg{stroke:var(--gold-600)}
.llist__ic--gold2{background:#F6EEDA}  .llist__ic--gold2 svg{stroke:var(--gold-600);fill:rgba(201,162,39,.18)}
.llist__ic--mint{background:#E2F1EE}   .llist__ic--mint svg{stroke:var(--teal-600)}
.llist li > span:nth-child(2){flex:1;min-width:0}
.llist b{display:block;font-size:9.5px;color:var(--navy-700);line-height:1.35}
.llist small{display:block;font-size:6.8px;color:var(--ink-4)}
.llist i{font-style:normal;color:var(--ink-4);font-size:12px;line-height:1}
.lprog{margin-block-start:auto;background:#fff;border:1px solid var(--line);border-radius:13px;padding:9px 10px}
.lprog__h{display:flex;justify-content:space-between;margin-block-end:6px}
.lprog__h span{font-size:8px;color:var(--ink-3)}
.lprog__h b{font-family:var(--ff-d);font-size:8.5px;color:var(--navy-700)}

/* ───────── 8. Generic section furniture ───────── */
.sec{padding-block:clamp(66px,8vw,120px);position:relative;overflow:hidden}
.sec--tint{background:var(--tint)}
.sec--dark{background:linear-gradient(200deg,var(--navy-800),var(--navy-900));color:#fff}

.eyebrow{
  font-family:var(--ff-d);font-size:.78rem;font-weight:600;letter-spacing:.13em;
  color:var(--teal-600);text-transform:uppercase;margin-block-end:14px;
}
.eyebrow--onDark{color:var(--teal-400)}

.shead{max-width:720px;margin-inline:auto;text-align:center;margin-block-end:clamp(36px,5vw,60px)}
.shead h2{font-size:clamp(1.6rem,2.9vw,2.4rem);letter-spacing:-.01em;text-wrap:balance}
.shead__lead{margin-block-start:16px;color:var(--ink-3);font-size:1.03rem;line-height:1.9}
.shead--start{margin-inline:0;text-align:start;margin-block-end:34px}
.sec--dark .shead h2{color:#fff}
.shead__lead--onDark{color:var(--ink-onDark)}

/* ───────── 9. Exams ───────── */
.exams{display:grid;grid-template-columns:repeat(3,1fr);gap:20px}
.exam{
  background:#fff;border:1px solid var(--line);border-radius:var(--r-l);
  padding:30px 26px 26px;
  transition:transform .25s var(--ease),box-shadow .25s var(--ease),border-color .25s;
}
.exam:hover{transform:translateY(-5px);border-color:transparent;box-shadow:0 22px 46px -24px rgba(11,33,64,.4)}
.exam__ic{
  width:46px;height:46px;border-radius:14px;display:grid;place-items:center;
  background:#E4EAF3;margin-block-end:18px;
}
.exam__ic svg{width:22px;height:22px;fill:none;stroke:var(--navy-700);stroke-width:1.7;stroke-linecap:round;stroke-linejoin:round}
/* rotate the three brand tints across the grid so the row doesn't flatten */
.exam:nth-child(3n+2) .exam__ic{background:#DCF3EE}
.exam:nth-child(3n+2) .exam__ic svg{stroke:var(--teal-600)}
.exam:nth-child(3n+3) .exam__ic{background:#FBF3DC}
.exam:nth-child(3n+3) .exam__ic svg{stroke:var(--gold-600)}
.exam h3{font-size:1.12rem;margin-block-end:9px;line-height:1.45}
.exam p{color:var(--ink-3);font-size:.94rem;line-height:1.85}
.exam__meta{display:flex;flex-wrap:wrap;gap:8px;margin-block-start:18px}
.exam__meta li{
  font-family:var(--ff-d);font-size:.74rem;font-weight:500;padding:5px 12px;border-radius:99px;
  background:var(--tint);color:var(--ink-2);
}
.exam--soon{background:linear-gradient(180deg,#fff,var(--tint));border-style:dashed}
.exam--soon .exam__ic{background:#FBF3DC}
.exam--soon .exam__ic svg{stroke:var(--gold-600)}

/* ───────── 10. Steps (a real sequence → numbering earns its place) ───────── */
.steps{
  display:grid;grid-template-columns:repeat(5,1fr);gap:18px;position:relative;
}
.steps::before{
  content:"";position:absolute;inset-block-start:23px;inset-inline:8%;
  height:2px;background:repeating-linear-gradient(90deg,var(--line-2) 0 8px,transparent 8px 16px);
}
.step{position:relative;text-align:center;padding-inline:6px}
.step__n{
  position:relative;z-index:1;
  width:48px;height:48px;border-radius:50%;display:grid;place-items:center;margin:0 auto 20px;
  font-family:var(--ff-d);font-size:1.15rem;font-weight:700;
  background:var(--navy-700);color:#fff;
  box-shadow:0 0 0 6px var(--bg);
}
.step:nth-child(2n) .step__n{background:var(--gold-500);color:var(--navy-900)}
.step h3{font-size:1.03rem;margin-block-end:8px}
.step p{color:var(--ink-3);font-size:.9rem;line-height:1.8}

/* ───────── 11. AI section ───────── */
.ai__in{position:relative;display:grid;grid-template-columns:1.05fr .95fr;gap:clamp(30px,5vw,70px);align-items:center}
.tabs{display:flex;flex-direction:column;gap:10px}
.tab{
  display:flex;align-items:center;gap:14px;text-align:start;
  padding:16px 18px;border-radius:var(--r-m);
  border:1px solid rgba(255,255,255,.12);background:rgba(255,255,255,.035);
  transition:background-color .22s,border-color .22s,transform .22s var(--ease);
}
.tab:hover{background:rgba(255,255,255,.07);transform:translateX(-4px)}
.tab__ic{
  width:40px;height:40px;border-radius:12px;flex:none;display:grid;place-items:center;
  background:rgba(63,169,175,.14);
}
.tab__ic svg{width:19px;height:19px;fill:none;stroke:var(--teal-400);stroke-width:1.7;stroke-linecap:round;stroke-linejoin:round}
.tab__tx b{display:block;font-family:var(--ff-d);font-size:1rem;color:#fff;line-height:1.4}
.tab__tx small{display:block;font-size:.84rem;color:rgba(196,214,226,.7);line-height:1.6}
.tab.is-on{background:rgba(201,162,39,.12);border-color:rgba(201,162,39,.45)}
.tab.is-on .tab__ic{background:rgba(201,162,39,.2)}
.tab.is-on .tab__ic svg{stroke:var(--gold-500)}

.ai__view{display:grid;place-items:center;perspective:1600px}
.phone--solo{
  position:relative;inset:auto;margin:0;
  transform:rotateY(-9deg) rotateX(4deg);
  animation:none;
}
.pane[hidden]{display:none}
.pane{animation:paneIn .45s var(--ease) both}
@keyframes paneIn{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:none}}

/* audio pane */
.scr--audio{background:linear-gradient(180deg,var(--navy-800),var(--navy-900));align-items:center;text-align:center;padding:16px 16px 20px}
.audio__eyebrow{font-size:7.5px;letter-spacing:.16em;color:var(--teal-400);text-transform:uppercase}
.audio__art{
  width:120px;height:120px;border-radius:26px;background:rgba(255,255,255,.06);
  display:grid;place-items:center;margin-block:6px;border:1px solid rgba(255,255,255,.1);
}
.audio__art img{width:86px;height:auto;filter:brightness(0) invert(1) opacity(.92)}
.audio__t{font-size:14px;color:#fff;font-family:var(--ff-d)}
.audio__s{font-size:8px;color:rgba(196,214,226,.72)}
.audio__bar{width:100%;height:3px;border-radius:99px;background:rgba(255,255,255,.16);margin-block-start:14px;overflow:hidden}
.audio__bar > i{display:block;height:100%;width:var(--w);background:linear-gradient(90deg,var(--teal-400),var(--gold-500));border-radius:99px}
.audio__times{width:100%;display:flex;justify-content:space-between;font-size:7px;color:rgba(196,214,226,.6);margin-block-start:5px}
.audio__ctl{display:flex;align-items:center;gap:16px;margin-block-start:14px}
.audio__sm svg{width:14px;height:14px;fill:rgba(255,255,255,.72)}
.audio__pl{width:36px;height:36px;border-radius:50%;background:#fff;display:grid;place-items:center}
.audio__pl svg{width:15px;height:15px;fill:var(--navy-800)}

/* slides pane */
.slides__top{display:flex;justify-content:space-between;align-items:center;font-size:7.5px;color:var(--ink-4)}
.slides__chip{background:#E4EAF3;color:var(--navy-700);padding:3px 8px;border-radius:99px;font-weight:700}
.slides__card{background:#fff;border:1px solid var(--line);border-radius:15px;padding:13px 12px}
.slides__h{font-size:11.5px;color:var(--navy-700);margin-block-end:9px;font-family:var(--ff-d)}
.slides__card li{display:flex;align-items:flex-start;gap:6px;font-size:8.5px;color:var(--ink-2);line-height:1.75;padding-block:3px}
.slides__card li i{width:5px;height:5px;border-radius:50%;background:var(--teal-500);margin-block-start:6px;flex:none}
.slides__thumbs{display:flex;gap:5px;justify-content:center;margin-block-start:4px}
.slides__thumbs span{width:16px;height:3px;border-radius:99px;background:var(--line)}
.slides__thumbs .is-on{background:var(--navy-700);width:24px}
.slides__nav{display:flex;gap:7px;margin-block-start:auto}
.slides__btn{
  flex:1;text-align:center;padding:8px;border-radius:99px;font-size:9px;font-weight:700;
  background:#fff;border:1px solid var(--line);color:var(--navy-700);
}
.slides__btn--p{background:var(--navy-700);border-color:var(--navy-700);color:#fff}

/* quiz pane */
.quiz__top{display:flex;justify-content:space-between;align-items:center;font-size:7.5px;color:var(--ink-4)}
.quiz__chip{background:#FBF3DC;color:var(--gold-600);padding:3px 8px;border-radius:99px;font-weight:700}
.quiz__q{font-size:10px;font-weight:700;color:var(--navy-700);line-height:1.7}
.quiz__pool{display:flex;flex-wrap:wrap;gap:5px}
.quiz__pool span{
  font-size:8px;padding:5px 10px;border-radius:99px;
  background:#fff;border:1px dashed var(--line-2);color:var(--ink-2);
}
.quiz__drops{display:flex;flex-direction:column;gap:6px;margin-block-start:3px}
.quiz__drop{
  padding:10px;border-radius:12px;font-size:9px;font-weight:600;text-align:center;
  background:#fff;border:1.5px dashed var(--line-2);color:var(--ink-3);
}
.quiz__drop.is-ok{border-style:solid;border-color:var(--teal-500);background:#E2F1EE;color:var(--teal-600)}

/* infographic pane */
.info__top{display:flex;justify-content:space-between;align-items:center;font-size:7.5px;color:var(--ink-4)}
.info__chip{background:#DCF3EE;color:var(--teal-600);padding:3px 8px;border-radius:99px;font-weight:700}
.info__graph{
  display:grid;grid-template-columns:repeat(5,1fr);gap:7px;align-items:end;
  height:126px;background:#fff;border:1px solid var(--line);border-radius:15px;padding:12px 10px;
}
.info__b{display:flex;flex-direction:column;justify-content:flex-end;align-items:center;gap:5px;height:100%}
.info__b i{display:block;width:100%;height:var(--h);border-radius:6px 6px 3px 3px;background:var(--teal-400);opacity:.85}
.info__b--gold i{background:var(--gold-500);opacity:1}
.info__b small{font-size:6.2px;color:var(--ink-4);white-space:nowrap}
.info__note{font-size:8px;color:var(--ink-2);line-height:1.7;background:#FBF3DC;border-radius:10px;padding:8px 10px}
.info__legend{display:flex;gap:12px;justify-content:center;margin-block-start:auto}
.info__legend span{display:flex;align-items:center;gap:5px;font-size:7px;color:var(--ink-4)}

/* ───────── 12. Plans ───────── */
.plans{display:grid;grid-template-columns:repeat(3,1fr);gap:22px;align-items:stretch}
.plan{
  position:relative;background:#fff;border:1px solid var(--line);border-radius:var(--r-l);
  padding:32px 28px;display:flex;flex-direction:column;
}
.plan--hero{
  background:linear-gradient(200deg,var(--navy-700),var(--navy-900));
  border-color:transparent;color:#fff;
  box-shadow:0 30px 60px -30px rgba(11,33,64,.6);
  transform:translateY(-10px);
}
.plan__flag{
  position:absolute;top:-13px;left:50%;transform:translateX(-50%);
  background:var(--gold-500);color:var(--navy-900);
  font-family:var(--ff-d);font-size:.74rem;font-weight:700;
  padding:6px 16px;border-radius:99px;white-space:nowrap;
}
.plan__n{font-size:1.16rem}
.plan--hero .plan__n{color:#fff}
.plan__d{margin-block-start:8px;font-size:.9rem;color:var(--ink-3);line-height:1.8;min-height:3.6em}
.plan--hero .plan__d{color:var(--ink-onDark)}
.plan__p{
  display:flex;align-items:baseline;gap:8px;
  margin-block:20px;padding-block-end:20px;border-block-end:1px solid var(--line);
}
.plan--hero .plan__p{border-color:rgba(255,255,255,.15)}
.plan__p b{font-family:var(--ff-d);font-size:2.5rem;font-weight:700;color:var(--navy-700);line-height:1}
.plan--hero .plan__p b{color:var(--gold-500)}
.plan__p span{font-size:.84rem;color:var(--ink-4)}
.plan--hero .plan__p span{color:rgba(196,214,226,.75)}
.plan__f{display:flex;flex-direction:column;gap:11px;margin-block-end:26px}
.plan__f li{position:relative;padding-inline-start:24px;font-size:.92rem;line-height:1.7}
.plan__f li::before{
  content:"";position:absolute;inset-inline-start:0;top:.5em;
  width:13px;height:7px;border-left:2px solid var(--teal-500);border-bottom:2px solid var(--teal-500);
  transform:rotate(-45deg);
}
.plan--hero .plan__f li{color:var(--ink-onDark)}
.plan--hero .plan__f li::before{border-color:var(--gold-500)}
.plan .btn{margin-block-start:auto}

.pay{
  margin-block-start:44px;text-align:center;
  background:#fff;border:1px solid var(--line);border-radius:var(--r-l);padding:28px 24px;
}
.pay__t{font-family:var(--ff-d);font-weight:600;color:var(--navy-700);margin-block-end:16px}
.pay__l{display:flex;flex-wrap:wrap;gap:12px;justify-content:center}
.pay__l li{
  font-family:var(--ff-d);font-weight:600;font-size:.95rem;letter-spacing:.02em;color:var(--navy-700);
  border:1px solid var(--line-2);border-radius:12px;padding:12px 26px;background:var(--tint);
}
.pay__n{margin-block-start:16px;font-size:.85rem;color:var(--ink-4)}

/* ───────── 13. Proof ───────── */
.nums{
  display:grid;grid-template-columns:repeat(4,1fr);gap:20px;
  margin-block-end:clamp(56px,7vw,88px);
  padding:34px 24px;border-radius:var(--r-l);
  background:var(--tint);border:1px solid var(--line);
}
.nums li{text-align:center}
.nums b{
  display:block;font-family:var(--ff-d);font-size:clamp(1.8rem,3vw,2.5rem);font-weight:700;
  color:var(--navy-700);line-height:1.15;font-variant-numeric:tabular-nums;
}
.nums__of{font-size:.9rem;color:var(--ink-4)}
.nums small{font-size:.87rem;color:var(--ink-3)}

.quotes{display:grid;grid-template-columns:repeat(3,1fr);gap:20px}
.quote{
  background:#fff;border:1px solid var(--line);border-radius:var(--r-l);
  padding:28px 26px;display:flex;flex-direction:column;gap:20px;
}
.quote__x{font-size:.97rem;line-height:1.95;color:var(--ink-2);flex:1}
.quote__w{display:flex;align-items:center;gap:12px;padding-block-start:18px;border-block-start:1px solid var(--line)}
.quote__a{
  width:40px;height:40px;border-radius:50%;flex:none;display:grid;place-items:center;
  background:#E4EAF3;color:var(--navy-700);font-family:var(--ff-d);font-weight:700;
}
.quote__w b{display:block;font-size:.94rem;color:var(--navy-700)}
.quote__w small{display:block;font-size:.82rem;color:var(--teal-600);font-weight:600}

/* ───────── 14. FAQ ─────────
   Narrow centred column on white, soft filled rows, and two pale
   rings drifting through the empty margins either side. */
.sec--faq{background:var(--bg);border-block-start:1px solid var(--line)}

.faq__arc{
  position:absolute;width:min(40vw,520px);aspect-ratio:1;pointer-events:none;
  fill:none;stroke:var(--teal-400);opacity:.72;
}
.faq__arc--a{inset-block-start:-7%;inset-inline-start:-13%}
.faq__arc--b{inset-block-end:-18%;inset-inline-end:-11%}

.faq{
  position:relative;z-index:1;
  max-width:720px;margin-inline:auto;
  display:flex;flex-direction:column;gap:12px;
}

.faq__i{
  background:var(--tint);border-radius:20px;overflow:hidden;
  border:1px solid transparent;
  transition:background-color .2s,border-color .2s;
}
.faq__i:hover{background:var(--tint-2)}
.faq__i[open]{border-color:var(--line)}

.faq__i summary{
  display:flex;align-items:center;justify-content:space-between;gap:16px;
  padding:19px 22px;cursor:pointer;list-style:none;
}
.faq__i summary::-webkit-details-marker{display:none}

.faq__q{
  font-family:var(--ff-d);font-weight:600;font-size:1.02rem;
  color:var(--navy-700);line-height:1.6;
}
.faq__ic{
  flex:none;width:34px;height:34px;border-radius:50%;
  background:#fff;display:grid;place-items:center;
  box-shadow:0 1px 3px rgba(11,33,64,.09);
  transition:transform .3s var(--ease);
}
.faq__ic svg{width:15px;height:15px;fill:none;stroke:var(--navy-700);stroke-width:2;stroke-linecap:round;stroke-linejoin:round}
.faq__i[open] .faq__ic{transform:rotate(180deg)}

.faq__a{padding:0 22px 22px;color:var(--ink-3);line-height:1.95;font-size:.95rem}

/* «لسه عندك سؤال؟» */
.faq__ask{
  margin-block-start:16px;background:#E2F1EE;border-radius:20px;
  padding:26px 28px;
  display:flex;align-items:center;justify-content:space-between;gap:22px;flex-wrap:wrap;
}
.faq__ask-tx h3{font-size:1.14rem;color:var(--navy-700)}
.faq__ask-tx p{margin-block-start:7px;font-size:.92rem;color:var(--ink-3);line-height:1.8;max-width:44ch}

/* ───────── 15. Final CTA ───────── */
.cta{
  position:relative;overflow:hidden;text-align:center;color:#fff;
  padding-block:clamp(70px,9vw,120px);
  background:
    radial-gradient(90% 70% at 50% 0%, #1B3A63 0%, transparent 60%),
    linear-gradient(200deg,var(--navy-700),var(--navy-900));
}
.cta__in{position:relative}
.cta__h{
  font-size:clamp(1.7rem,3.3vw,2.6rem);color:#fff;max-width:19em;margin-inline:auto;
  text-wrap:balance;letter-spacing:-.01em;
}
.cta__l{margin-block-start:18px;color:var(--ink-onDark)}
.cta__acts{display:flex;flex-wrap:wrap;gap:14px;justify-content:center;margin-block-start:36px}

.stores{margin-block-start:52px;padding-block-start:36px;border-block-start:1px solid rgba(255,255,255,.13)}
.stores__t{font-size:.87rem;color:rgba(196,214,226,.75);margin-block-end:16px}
.stores__l{display:flex;flex-wrap:wrap;gap:14px;justify-content:center}
.store{
  display:flex;align-items:center;gap:11px;
  padding:11px 22px;border-radius:14px;
  border:1px solid rgba(255,255,255,.24);background:rgba(255,255,255,.05);
  transition:background-color .2s,border-color .2s,transform .2s var(--ease);
}
.store:hover{background:rgba(255,255,255,.12);border-color:rgba(255,255,255,.5);transform:translateY(-2px)}
.store svg{width:23px;height:23px;fill:#fff;flex:none}
.store small{display:block;font-size:.68rem;color:rgba(196,214,226,.7);line-height:1.3}
.store b{display:block;font-family:var(--ff-d);font-size:.97rem;color:#fff;line-height:1.3}

/* ───────── 16. Footer ───────── */
.foot{background:var(--navy-900);color:var(--ink-onDark);padding-block:64px 0}
.foot__in{display:grid;grid-template-columns:1.7fr 1fr 1fr 1fr;gap:40px;padding-block-end:48px}
.foot__logo{width:118px;height:auto;background:#fff;border-radius:14px;padding:8px 12px;margin-block-end:18px}
.foot__brand p{font-size:.92rem;line-height:1.9;color:rgba(196,214,226,.72);max-width:34ch}
.foot__col{display:flex;flex-direction:column;gap:11px}
.foot__col h3{font-family:var(--ff-d);font-size:.95rem;color:#fff;margin-block-end:6px}
.foot__col a{font-size:.9rem;color:rgba(196,214,226,.72);transition:color .2s}
.foot__col a:hover{color:var(--gold-500)}
.social{display:flex;gap:10px;margin-block-end:8px}
.social a{
  width:38px;height:38px;border-radius:11px;display:grid;place-items:center;
  border:1px solid rgba(255,255,255,.16);transition:background-color .2s,border-color .2s;
}
.social a:hover{background:rgba(255,255,255,.1);border-color:rgba(255,255,255,.4)}
.social svg{width:17px;height:17px;fill:none;stroke:currentColor;stroke-width:1.7;stroke-linejoin:round}
.social li:first-child svg,.social li:last-child svg{fill:currentColor;stroke:none}
.foot__mail{font-size:.86rem;color:rgba(196,214,226,.6)}
.foot__bar{
  display:flex;flex-wrap:wrap;gap:10px;justify-content:space-between;
  padding-block:22px;border-block-start:1px solid rgba(255,255,255,.1);
  font-size:.83rem;color:rgba(196,214,226,.55);
}

/* ───────── 17. Reveal on scroll ───────── */
.reveal{opacity:0;transform:translateY(26px);transition:opacity .7s var(--ease),transform .7s var(--ease)}
.reveal.is-in{opacity:1;transform:none}

/* ───────── 18. Responsive ───────── */
@media (max-width:1080px){
  :root{--pw:212px}
  .cluster{height:470px}
  .phone--l{transform:translate(-50%,-50%) translateX(-128px) translateZ(-40px) rotateY(19deg) scale(.9)}
  .phone--r{transform:translate(-50%,-50%) translateX(128px) translateZ(-40px) rotateY(-19deg) scale(.9)}
  .exams,.plans,.quotes{grid-template-columns:repeat(2,1fr)}
  .steps{grid-template-columns:repeat(3,1fr);gap:34px 18px}
  .steps::before{display:none}
  .foot__in{grid-template-columns:1fr 1fr}
}

@media (max-width:900px){
  .nav__burger{display:flex}
  .nav__links{
    position:absolute;inset-block-start:100%;inset-inline:20px;
    flex-direction:column;align-items:stretch;gap:4px;
    background:rgba(11,33,64,.97);backdrop-filter:blur(16px);
    border:1px solid rgba(255,255,255,.12);border-radius:var(--r-m);
    padding:14px;
    opacity:0;visibility:hidden;transform:translateY(-10px);
    transition:opacity .25s,transform .25s var(--ease),visibility .25s;
  }
  .nav__links.is-open{opacity:1;visibility:visible;transform:none}
  .nav__links a{padding:12px 14px;border-radius:10px}
  .nav__links a:not(.btn)::after{display:none}
  .nav__links a:not(.btn):hover{background:rgba(255,255,255,.07)}
  .nav__cta{margin-block-start:8px;justify-content:center}

  /* stacked hero: centre the copy so it balances the centred phone below */
  .hero__in{grid-template-columns:1fr;gap:56px}
  .hero__copy{text-align:center}
  .chips,.hero__acts,.hero__trust{justify-content:center}
  .hero__lead{margin-inline:auto}
  .stage{perspective:1300px}
  .ai__in{grid-template-columns:1fr;gap:48px}
  .shead--start{text-align:center;margin-inline:auto}
  .tab{text-align:start}
}

@media (max-width:720px){
  :root{--pw:236px}
  .brand{padding:6px 10px;border-radius:14px}
  .brand__mark{width:72px}
  .cluster{height:520px}
  .phone--l,.phone--r{display:none}
  .phone--c{transform:translate(-50%,-50%) translateZ(0)}
  .cluster{transform:rotateX(3deg) rotateY(-7deg)}
  .exams,.plans,.quotes{grid-template-columns:1fr}
  .plan--hero{transform:none}
  .steps{grid-template-columns:1fr;gap:26px;text-align:start}
  .step{display:grid;grid-template-columns:auto 1fr;gap:0 18px;text-align:start;padding:0}
  .step__n{margin:0;width:42px;height:42px;font-size:1rem;box-shadow:none;grid-row:span 2}
  .step h3{align-self:center}
  .nums{grid-template-columns:repeat(2,1fr);gap:26px 12px}
  .faq__i summary{padding:16px 18px;gap:12px}
  .faq__q{font-size:.96rem}
  .faq__a{padding:0 18px 18px}
  .faq__ask{flex-direction:column;align-items:stretch;text-align:center;padding:24px 22px}
  .faq__ask-tx p{max-width:none}
  .faq__ask .btn{justify-content:center}
  .faq__arc{width:min(78vw,420px);opacity:.7}
  .foot__in{grid-template-columns:1fr;gap:34px}
  .hero__trust{gap:20px}
  .hero__trust dd{font-size:1.35rem}
}

@media (max-width:420px){
  :root{--pw:210px}
  .cluster{height:470px}
  .btn{padding:14px 24px;font-size:.9rem}
  .hero__acts .btn{flex:1}
}

/* ───────── 19. Motion & print ───────── */
@media (prefers-reduced-motion:reduce){
  html{scroll-behavior:auto}
  *,*::before,*::after{animation-duration:.001ms!important;animation-iteration-count:1!important;transition-duration:.001ms!important}
  .reveal{opacity:1;transform:none}
  .cluster{transition:none}
}

@media print{
  .nav,.stage,.cta__acts,.stores{display:none}
  body{color:#000;background:#fff}
}
